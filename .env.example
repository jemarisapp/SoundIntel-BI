# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# In production, set these in Vercel: Project Settings > Environment Variables.

# OpenAI (server only). Used by api/investigate.ts and never sent to the browser.
OPENAI_API_KEY=your_openai_api_key_here
# Optional, defaults to gpt-6-luna
# OPENAI_MODEL=gpt-6-luna

# Supabase public settings (safe in the browser; the database only allows reads)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service role key for the local data-entry scripts only.
# Never prefix it with VITE_ and never add it to Vercel.
SUPABASE_SERVICE_KEY=your_service_role_key_here
